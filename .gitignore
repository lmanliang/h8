# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead: `git config --global core.excludesfile '~/.gitignore_global'`

# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates).
/.env*
!/.env*.erb

# Ignore all logfiles and tempfiles.
/code/log/*
/code/tmp/*
/code/storage/*
!/code/log/.keep
!/code/tmp/.keep
!/code/storage/.keep

# Ignore pidfiles, but keep the directory.
/code/tmp/pids/*
!/code/tmp/pids/
!/code/tmp/pids/.keep

# Ignore uploaded files in development.
/code/storage/*
!/code/storage/.keep

# Ignore master key for decrypting credentials and more.
/code/config/master.key
/code/config/credentials/*.key

# Ignore precompiled assets
/code/public/assets
/code/public/packs
/code/public/packs-test

# Ignore yarn files
/code/node_modules
/code/yarn-error.log
/code/.yarn-integrity

# Ignore byebug history
.byebug_history

# Ignore coverage reports
/coverage/

# Ignore database files
/code/db/*.sqlite3
/code/db/*.sqlite3-*

# Ignore Spring files.
/code/tmp/spring/*

# Ignore bootsnap cache
/code/tmp/cache/bootsnap*

# macOS files
.DS_Store
*.swp
*.swo
*~

# IDE and editor files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Rails specific
/code/vendor/bundle
/code/.sass-cache

# Documentation build files (if any)
/docs/_site/
/docs/.jekyll-cache/
